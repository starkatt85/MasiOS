---
const services = [
  ["◈", "Certificates", "Services related to Income, Community, Nativity, Legal heir, OBC, Residence, and other certificates."],
  ["◎", "EC, Patta & Chitta", "Document certified copy, Patta name transfers and other supports."],
  ["✈", "Passport Applications", "New applications, renewals and appointment guidance."],
  ["▤", "PAN Card Services", "New PAN applications, corrections, reprints, and e-PAN downloads."],
  ["▣", "Ration Card Services", "New application, change of address, name deletion and addition, duplicate card print."],
  ["◉", "Voter ID Services", "New application, corrections, digital copy downloads."],
  ["▥", "Pensioner Life Certificate", "Life certificate and pay slip download."],
  ["▦", "EPFO Services", "PF withdrawal, PF account transfers, nominee updation, and other EPFO services."],
  ["▧", "Online Services", "TNPSC, RRB, TRB, SSC, JEE, NEET, government college applications, scholarship applications, and other online applications."],
];
---

<section id="services" class="noise-section border-t border-base-300 bg-base-200">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-primary">Our services</p>
      <h2 class="text-3xl font-black leading-tight sm:text-4xl">Digital services under one roof.</h2>
      <p class="mt-5 text-lg leading-8 text-base-content/70">Get support with essential online applications, government services, payments, and document work.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map(([icon, title, description], index) => (
        <article class="service-card-scroll border border-base-300 bg-base-100 p-6" data-flip-direction={index % 2 === 0 ? "left" : "right"}>
          <span class="text-3xl text-primary" aria-hidden="true">{icon}</span>
          <h3 class="mt-5 text-lg font-bold">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-base-content/60">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
