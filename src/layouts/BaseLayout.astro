---
import "../styles/global.css";
import "../styles/site.scss";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Masi Online Service Centre",
  description = "Fast and reliable digital and document services in Salem.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="masi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Metrophobic&family=Noto+Sans+Tamil:wght@100..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
